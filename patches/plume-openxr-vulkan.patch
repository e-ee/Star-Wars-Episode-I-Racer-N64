+        blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        if (flipY) {
+            blit.dstOffsets[0] = { 0, int32_t(dstHeight), 0 };
+            blit.dstOffsets[1] = { int32_t(dstWidth), 0, 1 };
